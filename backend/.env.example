# Backend API keys — copy this file to `.env` and fill in the values you have.
# Every feature degrades gracefully when a key is missing, so you can add them
# one at a time. python-dotenv loads this file automatically on startup.

# Google Gemini — powers the AI Assistant, transcript summaries, and market
# sentiment synthesis. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Tavily — financial news search (Company Media + Macro views).
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# YouTube Data API v3 — analysis / macro video search.
# Create at https://console.cloud.google.com (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
# Optional: comma-separated channel IDs for the Macro video feed
# YOUTUBE_CHANNELS=UCxxxx,UCyyyy
