# ─────────────────────────────────────────────────────────────
# Root .gitignore for the whole project (backend Python + shared).
# The frontend keeps its own Vite-generated frontend/.gitignore for
# Node-specific ignores (node_modules, dist, …).
# ─────────────────────────────────────────────────────────────

# ── Secrets / environment ──
# Never commit real API keys. The template `.env.example` IS committed.
.env
.env.*
!.env.example

# ── Per-user runtime data ──
backend/channels.json
# RAG vector store + persisted analysis history (regenerated at runtime)
backend/chroma_data/
backend/analysis_history/
# Fetched company data — SEC filings, news, earnings transcripts, price data,
# insider trades. All re-fetchable from source; stays local only, never on GitHub.
backend/data_lake/
backend/filing_cache/
backend/news_cache/
backend/price_cache/
backend/insider_cache/
backend/transcript_cache/
# In case download_filings.py is pointed back into the repo with --out downloads
downloads/
# Portfolio + trading journal (durable user data, never committed)
backend/portfolio.db
backend/portfolio.db-wal
backend/portfolio.db-shm
# Hybrid retrieval architecture's structured/search/registry DBs — regenerated
# at runtime from the source data, same treatment as portfolio.db
backend/financial_facts.duckdb
backend/financial_facts.duckdb.wal
backend/search_index.db
backend/search_index.db-wal
backend/search_index.db-shm
backend/registry.db
backend/registry.db-wal
backend/registry.db-shm

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
# Virtual environments
.venv/
venv/
env/
ENV/
# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node (root-level safety; frontend/ has its own too) ──
node_modules/
dist/
dist-ssr/
*.local

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS ──
.DS_Store
Thumbs.db

# ── Editors ──
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
