# ─────────────────────────────────────────────────────────────
# Root .gitignore for the whole project (backend Python + shared).
# The frontend keeps its own Vite-generated frontend/.gitignore for
# Node-specific ignores (node_modules, dist, …).
# ─────────────────────────────────────────────────────────────

# ── Secrets / environment ──
# Never commit real API keys. The template `.env.example` IS committed.
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
# Virtual environments
.venv/
venv/
env/
ENV/
# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node (root-level safety; frontend/ has its own too) ──
node_modules/
dist/
dist-ssr/
*.local

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS ──
.DS_Store
Thumbs.db

# ── Editors ──
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
